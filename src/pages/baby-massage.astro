---
import Layout from "../layouts/Layout.astro";
import { babyMassage, images, site } from "../config";
import { withBase } from "../lib/paths";
---

<Layout
  title="Baby Massage"
  description={`${babyMassage.name} — ${babyMassage.price} for a 4-week block of gentle baby massage classes. Bonding, colic relief and sleep support for new parents.`}
>
  <section class="page-hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Baby Massage</span>
        <h1>Learn to soothe, settle and bond with your baby.</h1>
        <p class="lead">{babyMassage.blurb}</p>
        <div class="meta">
          <span class="meta-price">{babyMassage.price}</span>
          <span class="meta-note">{babyMassage.priceNote}</span>
          <span class="meta-sep">·</span>
          <span>{babyMassage.duration}</span>
        </div>
        <div class="cta-row">
          <a class="btn btn-primary btn-lg" href={withBase("/book")}>Book your place</a>
          <a class="btn btn-outline btn-lg" href={withBase("/contact")}>Ask a question</a>
        </div>
      </div>
      <img src={images.babyMassage} alt="Parent and baby during a massage class" width="800" height="600" />
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div>
        <span class="eyebrow">What to expect</span>
        <h2>Everything's taken care of</h2>
        <p class="lead">
          You just bring yourself and your baby — we'll look after the rest.
        </p>
      </div>
      <ul class="expect-list">
        {babyMassage.whatToExpect.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section benefits">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">The benefits</span>
        <h2>Why parents love baby massage</h2>
      </div>
      <div class="benefits-grid">
        {
          babyMassage.benefits.map((b) => (
            <div class="benefit card">
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section cta-band">
    <div class="container cta-inner">
      <div>
        <h2>Ready when you are</h2>
        <p class="lead">{site.launchNote}</p>
      </div>
      <a class="btn btn-gold btn-lg" href={withBase("/book")}>Book a class</a>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding-block: clamp(2.5rem, 6vw, 5rem);
    background:
      radial-gradient(50% 60% at 90% 10%, var(--coral-100) 0%, transparent 60%),
      radial-gradient(50% 60% at 5% 100%, var(--gold-100) 0%, transparent 60%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero-grid img {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 1.75rem;
  }
  .meta-price {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    color: var(--primary-strong);
  }
  .meta-note, .meta-sep { color: var(--text-muted); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .expect-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .expect-list li {
    position: relative;
    padding: 1rem 1.25rem 1rem 3rem;
    background: var(--bg-soft);
    border: 1px solid rgba(106, 122, 77, 0.14);
    border-radius: var(--radius);
  }
  .expect-list li::before {
    content: "✓";
    position: absolute;
    left: 1.1rem;
    top: 0.95rem;
    font-weight: 800;
    color: var(--primary);
  }

  .benefits { background: var(--bg-soft); }
  .section-head { max-width: 44rem; margin-bottom: 2.5rem; }
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  .benefit h3 { font-size: 1.15rem; margin-bottom: 0.4rem; }
  .benefit p { margin: 0; font-size: 0.95rem; color: var(--text-muted); }

  .cta-band { background: var(--primary-soft); }
  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .cta-inner h2 { margin-bottom: 0.25rem; }
  .cta-inner .lead { margin: 0; }

  @media (max-width: 900px) {
    .hero-grid, .two-col { grid-template-columns: 1fr; }
    .benefits-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .benefits-grid { grid-template-columns: 1fr; }
  }
</style>
