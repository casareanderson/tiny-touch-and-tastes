---
import Layout from "../layouts/Layout.astro";
import { images } from "../config";
import { withBase } from "../lib/paths";
---

<Layout
  title="Meet Demi"
  description="Meet Demi, founder of Tiny Touch & Tastes — a qualified infant massage instructor and Level 4 RSPH nutritionist helping new parents navigate the early months."
>
  <section class="page-hero">
    <div class="container about-grid">
      <img class="about-photo" src={images.founder} alt="Demi, founder of Tiny Touch & Tastes" width="800" height="1000" />
      <div class="about-copy">
        <span class="eyebrow">Meet the founder</span>
        <h1>Welcome to Tiny Touch &amp; Tastes!</h1>
        <p class="lead">Hi, I'm Demi — the founder behind Tiny Touch &amp; Tastes.</p>
        <p>
          My journey to starting this business began when I was made redundant.
          While turning points like that can feel daunting, it gave me the push I
          needed to pause, retrain, and dedicate myself to two things I am genuinely
          passionate about: supporting early childhood development and helping new
          parents navigate the early months with confidence.
        </p>
        <p>
          I completed my Level 4 RSPH Nutrition qualification with Training Fit and
          trained as an Infant Massage Instructor with To Baby and Beyond. Combining
          these credentials allows me to offer gentle, evidence-based guidance across
          two of the most meaningful post-natal milestones: bonding through touch and
          introducing first foods.
        </p>
        <p>
          Whether you join a 4-week baby massage course to soothe colic, improve
          sleep, and connect with other local parents, or attend a weaning workshop to
          take the stress out of starting solids, my goal is simple: to create a warm,
          calm, and non-judgmental space for you and your baby.
        </p>
        <p class="signoff">I can't wait to welcome you to a class soon!</p>
      </div>
    </div>
  </section>

  <section class="section credentials">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Qualifications</span>
        <h2>Training you can trust</h2>
      </div>
      <div class="cred-grid">
        <div class="cred card">
          <h3>Infant Massage Instructor</h3>
          <p>Trained with To Baby and Beyond.</p>
        </div>
        <div class="cred card">
          <h3>Level 4 RSPH Nutrition</h3>
          <p>Awarded through Training Fit.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section cta-band">
    <div class="container cta-inner">
      <div>
        <h2>Come and say hello</h2>
        <p class="lead">Join a class, or drop me a message with any questions.</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-primary btn-lg" href={withBase("/book")}>Book a class</a>
        <a class="btn btn-outline btn-lg" href={withBase("/contact")}>Get in touch</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding-block: clamp(2.5rem, 6vw, 5rem);
    background:
      radial-gradient(50% 60% at 85% 10%, var(--coral-100) 0%, transparent 60%),
      radial-gradient(50% 60% at 8% 95%, var(--sage-100) 0%, transparent 60%);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .about-photo {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    position: sticky;
    top: 6rem;
  }
  .about-copy p { max-width: 40rem; }
  .signoff {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--primary-strong);
    margin-top: 1.5rem;
  }

  .credentials { background: var(--bg-soft); }
  .section-head { max-width: 44rem; margin-bottom: 2rem; }
  .cred-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .cred h3 { margin-bottom: 0.35rem; }
  .cred p { margin: 0; color: var(--text-muted); }

  .cta-band { background: var(--primary-soft); }
  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .cta-inner h2 { margin-bottom: 0.25rem; }
  .cta-inner .lead { margin: 0; }
  .cta-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-photo { position: static; }
    .cred-grid { grid-template-columns: 1fr; }
  }
</style>
