---
import Layout from "../layouts/Layout.astro";
import WaitingListForm from "../components/WaitingListForm.astro";
import { images, babyMassage, weaningWorkshop } from "../config";
import { withBase } from "../lib/paths";
---

<Layout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="coming-soon">
          <span class="dot" aria-hidden="true"></span>
          Coming soon
        </span>
        <h1>Gentle beginnings, guided with care.</h1>
        <p class="lead">
          Baby massage and weaning workshops for new parents — warm, calm and
          non-judgmental.
        </p>
        <a class="founder-link" href={withBase("/about")}>
          Meet Demi, your instructor <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="waitlist-card" id="waitlist">
        <span class="eyebrow">Be the first to know</span>
        <h2>Join the waiting list</h2>
        <p>Pop your details below and we'll let you know as soon as classes open.</p>
        <WaitingListForm />
        <div class="taster-link">
          <span>Want to try a class now?</span>
          <a href={withBase("/book?class=free-taster")}>
            Book a free taster <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section offerings">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our classes</span>
        <h2>A little support for your next step</h2>
      </div>

      <div class="offerings-grid">
        <a class="offering card" href={withBase("/baby-massage")}>
          <img src={images.babyMassage} alt="" width="800" height="600" loading="lazy" />
          <div class="offering-body">
            <div class="offering-top">
              <h3>{babyMassage.name}</h3>
              <span class="price">{babyMassage.price}</span>
            </div>
            <p>{babyMassage.blurb}</p>
            <span class="offering-link">Explore baby massage <span aria-hidden="true">→</span></span>
          </div>
        </a>

        <a class="offering card" href={withBase("/weaning-workshop")}>
          <img src={images.weaning} alt="" width="800" height="600" loading="lazy" />
          <div class="offering-body">
            <div class="offering-top">
              <h3>{weaningWorkshop.name}</h3>
              <span class="price">{weaningWorkshop.price}</span>
            </div>
            <p>{weaningWorkshop.blurb}</p>
            <span class="offering-link">Explore weaning <span aria-hidden="true">→</span></span>
          </div>
        </a>
      </div>

      <!-- Genuine parent testimonials will sit here, directly below the classes. -->
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(55% 75% at 92% 8%, var(--gold-100) 0%, transparent 65%),
      radial-gradient(55% 70% at 0% 100%, var(--coral-100) 0%, transparent 65%);
  }
  .hero::after {
    content: "";
    position: absolute;
    width: 28rem;
    height: 28rem;
    right: -12rem;
    bottom: -18rem;
    border-radius: 50%;
    background: var(--sage-100);
    opacity: 0.55;
    z-index: -1;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.85fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: center;
    min-height: min(46rem, calc(100svh - 5rem));
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .hero-copy {
    animation: rise 0.6s ease both;
  }
  .coming-soon {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--primary-soft);
    color: var(--primary-strong);
    font-weight: 800;
    font-size: 0.85rem;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1.5rem;
  }
  .coming-soon .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 1.8s ease-in-out infinite;
  }
  .hero h1 {
    max-width: 11ch;
    font-size: clamp(2.7rem, 6vw, 4.6rem);
    margin-bottom: 1.25rem;
  }
  .hero .lead {
    max-width: 32rem;
    font-size: clamp(1.1rem, 2vw, 1.3rem);
  }
  .founder-link {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    margin-top: 0.75rem;
    font-weight: 800;
  }
  .founder-link span,
  .offering-link span,
  .taster-link a span {
    transition: transform 0.2s ease;
  }
  .founder-link:hover span,
  .offering:hover .offering-link span,
  .taster-link a:hover span {
    transform: translateX(4px);
  }

  .waitlist-card {
    background: color-mix(in srgb, var(--bg-soft) 94%, transparent);
    border: 1px solid rgba(106, 122, 77, 0.16);
    border-radius: var(--radius-lg);
    box-shadow: 0 18px 60px rgba(65, 76, 49, 0.14);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    animation: rise 0.6s 0.12s ease both;
  }
  .waitlist-card h2 {
    margin-bottom: 0.4rem;
  }
  .waitlist-card > p {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .taster-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    border-top: 1px solid var(--sage-100);
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    font-size: 0.92rem;
    color: var(--text-muted);
  }
  .taster-link a {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    font-weight: 800;
    font-size: 1rem;
  }

  .offerings {
    background: var(--bg-soft);
  }
  .section-head {
    max-width: 44rem;
    margin-bottom: 2.25rem;
  }
  .offerings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .offering {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
    color: var(--text);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .offering:hover {
    text-decoration: none;
    transform: translateY(-5px);
    border-color: var(--sage-300);
    box-shadow: var(--shadow);
  }
  .offering img {
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .offering:hover img {
    transform: scale(1.025);
  }
  .offering-body {
    padding: 1.5rem;
  }
  .offering-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.65rem;
  }
  .offering-top h3 {
    margin: 0;
  }
  .offering-body p {
    color: var(--text-muted);
    font-size: 0.98rem;
  }
  .price {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--primary-strong);
    white-space: nowrap;
  }
  .offering-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--primary-strong);
    font-weight: 800;
    font-size: 0.92rem;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 800px) {
    .hero-grid {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: 2.25rem;
    }
    .hero h1 {
      max-width: 13ch;
    }
    .offerings-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-copy, .waitlist-card, .coming-soon .dot {
      animation: none;
    }
    .offering, .offering img {
      transition: none;
    }
  }
</style>
