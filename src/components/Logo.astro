---
import { images, site } from "../config";
import { withBase } from "../lib/paths";
interface Props {
  href?: string;
}
const { href = withBase("/") } = Astro.props;
---
<a class="logo" href={href} aria-label={`${site.name} — home`}>
  <img
    class="logo-img"
    src={withBase(images.logo)}
    alt={site.name}
    width="480"
    height="320"
  />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
  }
  .logo:hover {
    text-decoration: none;
  }
  .logo-img {
    width: 8.5rem;
    height: auto;
    display: block;
    mix-blend-mode: multiply;
  }
  @media (max-width: 480px) {
    .logo-img { width: 7rem; }
  }
</style>
