---
import { site } from "../config";
import { withBase } from "../lib/paths";
interface Props {
  href?: string;
}
const { href = withBase("/") } = Astro.props;
---
<a class="logo" href={href} aria-label={`${site.name} — home`}>
  <span class="logo-mark" aria-hidden="true">
    <svg viewBox="0 0 64 64" width="36" height="36">
      <circle cx="32" cy="32" r="30" fill="#82935f" />
      <path
        d="M32 41c-6.6-4.4-10.6-8.7-10.6-13.3 0-3.6 2.8-6.3 6.1-6.3 2.3 0 4.2 1.4 4.5 3.8.2-2.4 2.1-3.8 4.4-3.8 3.3 0 6.1 2.7 6.1 6.3C42.6 32.3 38.6 36.6 32 41z"
        fill="#f6c9c2"
      />
      <circle cx="45" cy="20" r="3.6" fill="#f0c96b" />
    </svg>
  </span>
  <span class="logo-word">
    <span class="logo-name">Tiny Touch &amp; Tastes</span>
    <span class="logo-tag">baby massage · weaning</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    line-height: 1;
  }
  .logo:hover {
    text-decoration: none;
  }
  .logo-mark {
    display: inline-flex;
    flex-shrink: 0;
  }
  .logo-word {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .logo-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .logo-tag {
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary);
  }
</style>
