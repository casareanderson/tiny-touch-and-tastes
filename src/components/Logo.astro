---
import { site } from "../config";
import { withBase } from "../lib/paths";
interface Props {
  href?: string;
}
const { href = withBase("/") } = Astro.props;
---
<a class="logo" href={href} aria-label={`${site.name} — home`}>
  <span class="logo-text">{site.name}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
  }
  .logo:hover {
    text-decoration: none;
  }
  .logo-text {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary-strong);
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .logo-text { font-size: 1.25rem; }
  }
</style>
