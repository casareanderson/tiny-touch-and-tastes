---
import { images, site } from "../config";
import { withBase } from "../lib/paths";
interface Props {
  href?: string;
}
const { href = withBase("/") } = Astro.props;
---
<a class="logo" href={href} aria-label={`${site.name} — home`}>
  <img
    class="logo-img"
    src={withBase(images.logo)}
    alt={site.name}
    width="160"
    height="43"
  />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
  }
  .logo:hover {
    text-decoration: none;
  }
  .logo-img {
    height: 2rem;
    width: auto;
  }
</style>
